{
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/changelog", "destination": "/changelog.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/license", "destination": "/license.html" },
    { "source": "/cookie", "destination": "/cookie.html" },
    { "source": "/scraper", "destination": "/scraper.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/iqc", "destination": "/iqc.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/404.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}